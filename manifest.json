{
  "schemaVersion": "mnxpack_manifest_v1",
  "id": "exam-room",
  "version": "0.1.0",
  "kind": "experience",
  "label": "Exam Room",
  "description": "Practise the written exam. Answer past-paper questions, design the experiment and read the data under a timer, then mark yourself against the scheme and the model answer. Private study pack built from course material.",
  "tagline": "Read it, write it, mark it against the scheme",
  "icon": "fa-solid fa-file-pen",
  "author": "Private study pack for one student",
  "subjects": [
    "biochemistry",
    "molecular biology",
    "genome expression and maintenance",
    "biochemical reactions and interactions",
    "experimental design"
  ],
  "knowledgeBinding": {
    "mode": "none"
  },
  "surfaces": {},
  "practice": {
    "version": 1,
    "catalogue": "assets/practice/catalogue.json"
  },
  "permissions": [
    "storage:local"
  ],
  "settings": [
    {
      "id": "timerStyle",
      "label": "Timer",
      "description": "Count down from the suggested time, or count up from zero.",
      "type": "choice",
      "default": "down",
      "options": [
        {
          "value": "down",
          "label": "Count down"
        },
        {
          "value": "up",
          "label": "Count up"
        }
      ]
    },
    {
      "id": "showHints",
      "label": "Show hints",
      "description": "Some questions have a hint from the lecturer. Using one is recorded.",
      "type": "toggle",
      "default": true
    }
  ],
  "engines": {
    "mnxSdk": "1.0.0"
  },
  "entry": {
    "logicalPath": "code/main.cjs"
  },
  "assets": [
    {
      "logicalPath": "assets/practice/catalogue.json",
      "mimeType": "application/json"
    },
